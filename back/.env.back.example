# App settings
NODE_ENV=production
PORT=3000
FRONTEND_PORT=5173
# Примечание: ALLOWED_ORIGINS должен включать FRONTEND_PORT
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DB_NAME=true_code_db
DB_USER=true_code
DB_PASSWORD=secret_password
DB_PORT=5432
DB_HOST=db

# Auth
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Security
BCRYPT_SALT_ROUNDS=10
PASSWORD_PEPPER=change_this_to_a_secure_random_string
