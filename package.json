{
  "name": "true-code-test",
  "version": "1.0.0",
  "private": true,
  "description": "Fullstack project with Clean Architecture",
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "back/**/*.ts": [
      "npm run lint --prefix back",
      "npm run test --prefix back -- --findRelatedTests --passWithNoTests"
    ],
    "front/**/*.{ts,tsx}": [
      "npm run lint --prefix front"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3"
  }
}
